# Alpha — LangChain social-media-agent-lungmat (F0)
# Copy to oss-forks/social-media-agent-lungmat/.env

BRAND_ID=alpha
TZ=Asia/Ho_Chi_Minh

# LLM
ANTHROPIC_API_KEY=
# Model override in code: claude-haiku-4-5 (daily) — Sonnet only VIP

# LangSmith (optional, local dev)
LANGSMITH_API_KEY=
LANGSMITH_TRACING_V2=true

# Scrape
FIRECRAWL_API_KEY=

# Disable direct publish — use webhook
USE_ARCADE_AUTH=false
LUNGMAT_WEBHOOK_ONLY=true
N8N_WEBHOOK_URL=https://your-n8n.app/webhook/content-ready

# Telegram HITL (thay Slack)
TELEGRAM_BOT_TOKEN=
N8N_TELEGRAM_ADMIN_CHAT_ID=

# Zernio (reference for n8n — not used in factory)
# ZERNIO_ACCOUNT_X=6a0c6dbd5e333c05299f1d12
# ZERNIO_ACCOUNT_THREADS=6a0c28345e333c05299b981a

# RSS / URL seed (F3 fin-thread sẽ push; F0 manual URL OK)
# RSS_SOURCES=forexfactory,fxstreet,investing

# Persona file path (inject vào prompts)
LUNGMAT_PERSONA_PATH=../prompts/alpha-persona.md
# Pack system prompt (optional — defaults to services/alpha-factory/prompts/alpha_writer.md)
# LUNGMAT_PACK_PROMPT_PATH=../../../services/alpha-factory/prompts/alpha_writer.md

# Default URL for yarn generate_post:alpha
ALPHA_CONTENT_URL=https://www.fxstreet.com/news/gold

TOPIC=XAUUSD daily brief — liquidity và macro (Fed, DXY)
