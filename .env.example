PORT=3000
AGENT_SHARED_SECRET=change_me_before_running
NODE_ENV=development

# Optional — if missing, Supabase logging is silently skipped
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — LLM integration (if missing or MOCK_LLM=1, mock responses are used)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional — Image generation via OpenAI gpt-image-2 (if missing, placeholder mock URLs are used)
OPENAI_API_KEY=

# Optional — Apify web scraping (if missing or MOCK_LLM=1, mock data is used)
APIFY_API_TOKEN=

# Optional — Telegram publishing (if missing or MOCK_LLM=1, publish is simulated)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Per-brand Telegram channels (Media OS — /content alpha|raymond|vip10x)
# Falls back to TELEGRAM_CHAT_ID if brand-specific var is empty
TELEGRAM_CHAT_ID_ALPHA=
TELEGRAM_CHAT_ID_RAYMOND=
TELEGRAM_CHAT_ID_VIP10X=

# DM chat ID for sending drafts to admin for approval before publishing to channel.
# Get your chat ID from /debug_env after messaging the bot.
ADMIN_TELEGRAM_CHAT_ID=

# Optional — Typefully API (7C). Without key: approve X/Threads returns copy text for manual paste.
TYPEFULLY_API_KEY=

# Phase 7D-5: Telegram receive mode — 'longpoll' (default, dev) or 'webhook' (production HTTPS)
TELEGRAM_MODE=longpoll
TELEGRAM_WEBHOOK_URL=https://agent.hoa-homes.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=<random-64-char-hex>
