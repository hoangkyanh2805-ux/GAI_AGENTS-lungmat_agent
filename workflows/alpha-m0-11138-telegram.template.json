{
  "name": "Alpha Media M0 (from n8n #11138)",
  "nodes": [
    {
      "parameters": {
        "content": "## Alpha M0 — fork n8n #11138\n\n**Gốc:** https://n8n.io/workflows/11138\n**Đã bỏ:** Gemini ảnh · FB · Instagram · Blotato · Drive upload ảnh AI\n**Giữ:** Telegram approval loop (AI Agent + Send and Wait)\n**Đổi:** Claude Sonnet · Zernio HTTP · compliance Alpha\n\n**KEY:** Settings → Variables (xem docs/N8N_ALPHA_KEYS_SETUP.md)\n**accounts:** X 6a0c6dbd… · Threads 6a0c2834…\n**Ảnh M0:** reply OK đăng + mediaId (Zernio Media, không Gemini)",
        "height": 420,
        "width": 480,
        "color": 5
      },
      "id": "b2000001-0000-4000-8000-000000000001",
      "name": "README Sticky",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-640, -80]
    },
    {
      "parameters": {},
      "id": "b2000001-0000-4000-8000-000000000002",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 8 * * *" }]
        }
      },
      "id": "b2000001-0000-4000-8000-000000000003",
      "name": "Cron 08:00 VN",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200],
      "disabled": true
    },
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "b2000001-0000-4000-8000-000000000004",
      "name": "Listen for incoming events",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [0, 400],
      "webhookId": "alpha-m0-telegram-in",
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_ME",
          "name": "Telegram Alpha Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const brands = {\n  brand: 'alpha',\n  topic: 'XAUUSD daily brief — liquidity và macro (Fed, DXY)',\n  zernio_account_ids: ['6a0c6dbd5e333c05299f1d12', '6a0c28345e333c05299b981a'],\n  x_account_id: '6a0c6dbd5e333c05299f1d12',\n  threads_account_id: '6a0c28345e333c05299b981a',\n  x_handle: '@AlphaTrading79',\n  threads_handle: '@alphatrading.lab'\n};\nconst item = $input.first().json;\nlet userText = brands.topic;\nif (item.message?.text) userText = item.message.text;\nconst now = new Date();\nconst pad = (n) => String(n).padStart(2, '0');\nconst d = `${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())}`;\nconst t = `${pad(now.getHours())}${pad(now.getMinutes())}`;\nconst runId = `alpha-${d}-${t}-${Math.random().toString(36).slice(2, 6)}`;\nconst chatId = item.message?.chat?.id || $env.N8N_TELEGRAM_ADMIN_CHAT_ID;\nreturn [{ json: {\n  ...brands,\n  run_id: runId,\n  date: d,\n  created_at: now.toISOString(),\n  user_text: userText,\n  chat_id: chatId,\n  status: 'draft_ready'\n} }];"
      },
      "id": "b2000001-0000-4000-8000-000000000005",
      "name": "Bootstrap brands.json",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [280, 200]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.user_text }}",
        "options": {
          "systemMessage": "Bạn là Alpha Content Writer (Alpha Trading Lab, XAUUSD). Không GoClaw. Không đăng bài.\n\nLuồng:\n1) Nhận ý tưởng/topic từ user → đề xuất draft (telegram_brief, x_thread, threads_post).\n2) User phản hồi sửa → chỉnh theo feedback (giữ memory).\n3) Khi user nói OK / approved / OK đăng / duyệt → trả ĐÚNG MỘT JSON (không markdown):\n{\"brand\":\"alpha\",\"topic\":\"...\",\"telegram_brief\":\"...\",\"x_thread\":[\"1/ ...\"],\"threads_post\":\"...\",\"youtube_pack\":{},\"compliance\":{\"status\":\"PASS\",\"failed_rules\":[]},\"data_status\":\"verified\"}\n\nQuy tắc: không signal/entry/SL/TP; không hứa lợi nhuận; mỗi tweet ≤280 ký tự; threads_post ≤500; không URL trong tweet."
        }
      },
      "id": "b2000001-0000-4000-8000-000000000006",
      "name": "AI Agent Content",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [560, 200]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-4-20250514"
        },
        "options": {}
      },
      "id": "b2000001-0000-4000-8000-000000000007",
      "name": "Claude Sonnet",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [560, 420],
      "credentials": {
        "anthropicApi": {
          "id": "CONFIGURE_ME",
          "name": "Anthropic Alpha"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ String($('Bootstrap brands.json').item.json.chat_id) }}",
        "contextWindowLength": 8
      },
      "id": "b2000001-0000-4000-8000-000000000008",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [760, 420]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "has-brand",
              "leftValue": "={{ $json.output }}",
              "rightValue": "\"brand\"",
              "operator": { "type": "string", "operation": "contains" }
            },
            {
              "id": "has-x-thread",
              "leftValue": "={{ $json.output }}",
              "rightValue": "\"x_thread\"",
              "operator": { "type": "string", "operation": "contains" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2000001-0000-4000-8000-000000000009",
      "name": "Approved from user?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [840, 200]
    },
    {
      "parameters": {
        "chatId": "={{ $('Listen for incoming events').first().json.message.chat.id }}",
        "text": "={{ $json.output }}",
        "additionalFields": {}
      },
      "id": "b2000001-0000-4000-8000-00000000000a",
      "name": "Send proposal to user",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1040, 360],
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_ME",
          "name": "Telegram Alpha Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Bootstrap brands.json').first().json;\nconst aiOutput = String($input.first().json.output || $input.first().json.text || '');\nlet jsonString = aiOutput.replace(/```json\\s*/gi, '').replace(/```\\s*/g, '');\nconst m = jsonString.match(/\\{[\\s\\S]*\\}/);\nif (!m) {\n  throw new Error('Chưa có JSON pack. Trên Telegram reply: OK hoặc approved — đừng gửi topic mới. AI preview: ' + aiOutput.slice(0, 200));\n}\nlet pack;\ntry {\n  pack = JSON.parse(m[0]);\n} catch (e) {\n  throw new Error('JSON lỗi cú pháp. Reply OK để AI gửi lại JSON thuần.');\n}\npack.brand = 'alpha';\npack.topic = pack.topic || ctx.topic;\npack.run_id = ctx.run_id;\nif (!Array.isArray(pack.x_thread)) {\n  pack.x_thread = typeof pack.x_thread === 'string' ? pack.x_thread.split(/\\n+/).filter(Boolean) : [];\n}\nconst banned = [/vào long/i, /vào short/i, /entry/i, /\\bSL\\b/i, /\\bTP\\b/i, /chắc ăn/i, /guaranteed/i];\nconst failed = [];\nconst allText = (pack.telegram_brief || '') + pack.x_thread.join(' ');\nif (banned.some((r) => r.test(allText))) failed.push(1);\nfor (const t of pack.x_thread) {\n  if (t.length > 280) failed.push(4);\n  if (/https?:\\/\\//i.test(t)) failed.push(4);\n}\nif ((pack.threads_post || '').length > 500) failed.push(4);\npack.compliance = { status: failed.length ? 'FAIL' : 'PASS', failed_rules: [...new Set(failed)] };\nreturn [{ json: { ...ctx, pack } }];"
      },
      "id": "b2000001-0000-4000-8000-00000000000b",
      "name": "Parse Pack + Compliance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 80]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "pass",
              "leftValue": "={{ $json.pack.compliance.status }}",
              "rightValue": "PASS",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2000001-0000-4000-8000-00000000000c",
      "name": "Compliance PASS?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, 80]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "=❌ Compliance FAIL {{ $json.run_id }}\nRules: {{ $json.pack.compliance.failed_rules }}\nGửi topic mới hoặc sửa draft.",
        "additionalFields": {}
      },
      "id": "b2000001-0000-4000-8000-00000000000d",
      "name": "Telegram FAIL",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1320, 280],
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_ME",
          "name": "Telegram Alpha Bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "chatId": "={{ $json.chat_id }}",
        "message": "=Alpha {{ $json.run_id }} — Compliance PASS\n\n--- Threads (≤500) ---\n{{ $json.pack.threads_post }}\n\n--- X tweet 1 (≤280) ---\n{{ $json.pack.x_thread[0] }}\n\nReply **OK đăng** + **mediaId** (ảnh đã upload Zernio Media).\nVí dụ: OK đăng mediaId: abc123",
        "approvalOptions": {
          "approvalType": "double"
        },
        "options": {}
      },
      "id": "b2000001-0000-4000-8000-00000000000e",
      "name": "Send and wait approval",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1560, 0],
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_ME",
          "name": "Telegram Alpha Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Parse Pack + Compliance').first().json;\nconst r = $input.first().json;\nconst approved = r.data?.approved === true || /OK đăng|OK dang|duyệt|approved/i.test(JSON.stringify(r));\nconst text = r.data?.text || r.message?.text || '';\nconst mediaId = (text.match(/mediaId[:\\s]+([\\w-]+)/i) || [])[1] || r.data?.media_id;\nif (!approved) throw new Error('Publish not approved');\nreturn [{ json: {\n  ...prev,\n  status: 'approved',\n  approved_at: new Date().toISOString(),\n  media: { mode: 'manual_mediaId', media_id: mediaId || null }\n} }];"
      },
      "id": "b2000001-0000-4000-8000-00000000000f",
      "name": "Parse Approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1800, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.ZERNIO_API_BASE || 'https://api.zernio.com').replace(/\\/$/, '') }}/v1/posts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.ZERNIO_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": {{ JSON.stringify($json.pack.x_thread[0] || '') }},\n  \"threadsText\": {{ JSON.stringify($json.pack.threads_post || '') }},\n  \"platforms\": [\"twitter\", \"threads\"],\n  \"accountIds\": {{ JSON.stringify($json.zernio_account_ids) }},\n  \"status\": \"PUBLISHED\",\n  \"mediaIds\": {{ $json.media.media_id ? JSON.stringify([$json.media.media_id]) : '[]' }}\n}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "b2000001-0000-4000-8000-000000000010",
      "name": "Zernio Publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2040, 0],
      "notesInFlow": true,
      "notes": "Sửa path/body theo Zernio OpenAPI. Không Blotato/GoClaw."
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.N8N_MEDIA_SHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "alpha_publish_log" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "run_id": "={{ $json.run_id }}",
            "date": "={{ $now.toISO() }}",
            "topic": "={{ $json.pack.topic }}",
            "compliance": "={{ $json.pack.compliance.status }}",
            "media_id": "={{ $json.media.media_id }}",
            "zernio_post_id": "={{ $json.zernio_post_id }}",
            "status": "={{ $json.status }}"
          }
        },
        "options": {}
      },
      "id": "b2000001-0000-4000-8000-000000000011",
      "name": "Google Sheet Log",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2520, 0],
      "disabled": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "CONFIGURE_ME",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Parse Approval').first().json;\nconst z = $input.first().json;\nconst postId = z.id || z.postId || z.data?.id || null;\nreturn [{ json: {\n  run_id: ctx.run_id,\n  brand: 'alpha',\n  status: postId ? 'published' : 'failed',\n  zernio_post_id: postId,\n  pack: ctx.pack,\n  media: ctx.media\n} }];"
      },
      "id": "b2000001-0000-4000-8000-000000000012",
      "name": "Merge Run JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2280, 0]
    },
    {
      "parameters": {
        "chatId": "={{ $('Parse Approval').item.json.chat_id }}",
        "text": "=✅ Alpha published run {{ $('Merge Run JSON').item.json.run_id }}\nZernio post: {{ $('Merge Run JSON').item.json.zernio_post_id || 'check dashboard' }}\nX @AlphaTrading79 · Threads @alphatrading.lab",
        "additionalFields": {}
      },
      "id": "b2000001-0000-4000-8000-000000000013",
      "name": "Confirm Published",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2760, 0],
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_ME",
          "name": "Telegram Alpha Bot"
        }
      }
    }
  ],
